ARG UBUNTU_VERSION=24.04
ARG BASE_IMAGE=ubuntu:24.04

FROM ubuntu:${UBUNTU_VERSION} AS transcribe-builder
ARG TRANSCRIBE_REF=be7a8b35e9ba2df20298bd26e32d53407c3bcbcd
RUN apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    build-essential cmake ninja-build git ca-certificates libvulkan-dev glslc libopenblas-dev \
 && rm -rf /var/lib/apt/lists/*
WORKDIR /src
RUN git clone https://github.com/handy-computer/transcribe.cpp.git \
 && cd transcribe.cpp \
 && git checkout "${TRANSCRIBE_REF}" \
 && cmake -S . -B build -GNinja \
      -DCMAKE_BUILD_TYPE=Release \
      -DTRANSCRIBE_BUILD_SHARED=ON \
      -DTRANSCRIBE_VULKAN=ON \
      -DTRANSCRIBE_BUILD_TESTS=OFF \
      -DTRANSCRIBE_BUILD_EXAMPLES=OFF \
      -DTRANSCRIBE_USE_SYSTEM_BLAS=ON \
 && cmake --build build --parallel

ARG BASE_IMAGE=ubuntu:24.04
FROM ${BASE_IMAGE}
LABEL org.opencontainers.image.source="https://github.com/GodsQuantum/speaches-extended"
LABEL org.opencontainers.image.licenses="MIT"
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      ca-certificates curl ffmpeg libopenblas0-pthread libvulkan1 mesa-vulkan-drivers
RUN useradd --create-home --shell /bin/bash --uid 1000 ubuntu || true
USER ubuntu
ENV HOME=/home/ubuntu \
    PATH=/home/ubuntu/.local/bin:$PATH \
    UV_LINK_MODE=copy \
    UV_CACHE_DIR=/home/ubuntu/.cache/uv \
    UV_PYTHON_CACHE_DIR=/home/ubuntu/.cache/uv/python
WORKDIR $HOME/speaches
COPY --chown=ubuntu --from=ghcr.io/astral-sh/uv:0.10 /uv /bin/uv
COPY --chown=ubuntu uv.lock pyproject.toml ./
RUN --mount=type=cache,target=/home/ubuntu/.cache/uv,uid=1000,gid=1000 \
    uv sync --frozen --compile-bytecode --no-install-project --no-dev
COPY --chown=ubuntu . .
RUN --mount=type=cache,target=/home/ubuntu/.cache/uv,uid=1000,gid=1000 \
    uv sync --frozen --compile-bytecode --no-dev
RUN mkdir -p $HOME/.cache/huggingface/hub
USER root
RUN mkdir -p /opt/transcribe/lib /opt/transcribe-python
COPY --from=transcribe-builder /src/transcribe.cpp/build/src/libtranscribe.so* /opt/transcribe/lib/
COPY --from=transcribe-builder /src/transcribe.cpp/build/ggml/src/libggml.so* /opt/transcribe/lib/
COPY --from=transcribe-builder /src/transcribe.cpp/build/ggml/src/libggml-base.so* /opt/transcribe/lib/
COPY --from=transcribe-builder /src/transcribe.cpp/build/ggml/src/libggml-cpu.so* /opt/transcribe/lib/
COPY --from=transcribe-builder /src/transcribe.cpp/build/ggml/src/ggml-vulkan/libggml-vulkan.so* /opt/transcribe/lib/
COPY --from=transcribe-builder /src/transcribe.cpp/bindings/python/src/transcribe_cpp /opt/transcribe-python/transcribe_cpp
RUN echo "/opt/transcribe/lib" > /etc/ld.so.conf.d/transcribe.conf && ldconfig
USER ubuntu

ENV UVICORN_HOST=0.0.0.0 \
    UVICORN_PORT=8000 \
    PATH=/home/ubuntu/speaches/.venv/bin:$PATH \
    PYTHONPATH=/opt/transcribe-python:/home/ubuntu/speaches/src \
    TRANSCRIBE_LIBRARY=/opt/transcribe/lib/libtranscribe.so \
    TRANSCRIBE_BACKEND=vulkan \
    LD_LIBRARY_PATH=/opt/transcribe/lib \
    DO_NOT_TRACK=1 \
    GRADIO_ANALYTICS_ENABLED=False \
    DISABLE_TELEMETRY=1 \
    HF_HUB_DISABLE_TELEMETRY=1 \
    PYANNOTE_METRICS_ENABLED=0
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 CMD curl -fsS http://127.0.0.1:8000/health || exit 1
CMD ["uvicorn", "--factory", "speaches.main:create_app"]
