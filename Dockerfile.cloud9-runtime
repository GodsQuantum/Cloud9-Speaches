FROM cloud9/speaches:993994f-fw1.2.1-ct2-4.8.2-fw12compat

USER root
RUN apt-get update \
 && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
      libopenblas0-pthread libvulkan1 mesa-vulkan-drivers \
 && rm -rf /var/lib/apt/lists/*

COPY cloud9-artifacts/transcribe/lib/ /opt/transcribe/lib/
COPY cloud9-artifacts/transcribe/python/transcribe_cpp/ /opt/transcribe-python/transcribe_cpp/
COPY src/speaches/executors/transcribe_cpp.py /home/ubuntu/speaches/src/speaches/executors/transcribe_cpp.py
COPY src/speaches/executors/shared/registry.py /home/ubuntu/speaches/src/speaches/executors/shared/registry.py
COPY src/speaches/executors/shared/base_model_manager.py /home/ubuntu/speaches/src/speaches/executors/shared/base_model_manager.py
COPY src/speaches/routers/stt.py /home/ubuntu/speaches/src/speaches/routers/stt.py
COPY src/speaches/routers/diarization.py /home/ubuntu/speaches/src/speaches/routers/diarization.py

RUN echo '/opt/transcribe/lib' > /etc/ld.so.conf.d/cloud9-transcribe.conf && ldconfig
USER ubuntu
ENV PYTHONPATH=/opt/transcribe-python:/home/ubuntu/speaches/src
ENV TRANSCRIBE_LIBRARY=/opt/transcribe/lib/libtranscribe.so
ENV TRANSCRIBE_BACKEND=vulkan
ENV LD_LIBRARY_PATH=/opt/transcribe/lib
