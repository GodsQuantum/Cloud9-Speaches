SPEACHES_PORT=8000
STT_MODEL_TTL=120
TTS_MODEL_TTL=60
VAD_MODEL_TTL=300
ENABLE_UI=true
PRELOAD_MODELS=[]

# Vulkan (AMD / Intel): set this to the GID of /dev/dri/renderD* on the host.
RENDER_GID=109

